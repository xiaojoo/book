<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 只有「词典」这一颗用得到：本机读文件、入库、排版全程不联网。
         加了它就要在 AI 设置页里说清楚"这一条链路会把选中的那段文字发出去"。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="长文阅读"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- usesCleartextTraffic 是给内网 Ollama / LM Studio / 自建中转留的口子（他选的那档"两种都收"）。
             代价：http:// 地址上秘钥和正文都是明文走网，所以填 http 时界面必须标出来。 -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 文件管理器里"用本应用打开"：content:// 走 uri 授权，不需要存储权限。
                 mime 列表要跟 BookLibrary 的入库分派和书架那颗导入按钮的 picker 保持一致，
                 少一行就是"这个格式我们能读，但系统不会想到我们"。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="file" android:mimeType="text/plain" />
                <data android:scheme="content" android:mimeType="text/markdown" />
                <data android:scheme="file" android:mimeType="text/markdown" />
                <data android:scheme="content" android:mimeType="application/epub+zip" />
                <data android:scheme="file" android:mimeType="application/epub+zip" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="file" android:mimeType="application/pdf" />
                <data android:scheme="content" android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:scheme="file" android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:scheme="content" android:mimeType="application/x-mobipocket-ebook" />
                <data android:scheme="file" android:mimeType="application/x-mobipocket-ebook" />
                <data android:scheme="content" android:mimeType="application/vnd.amazon.ebook" />
                <data android:scheme="file" android:mimeType="application/vnd.amazon.ebook" />
                <data android:scheme="content" android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:scheme="file" android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>
        </activity>
    </application>

</manifest>
