<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 只有「词典」这一颗用得到：本机读文件、入库、排版全程不联网。
         加了它就要在 AI 设置页里说清楚"这一条链路会把选中的那段文字发出去"。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 下载走 WorkManager 的前台那一档：Android 14 起 dataSync 是单独的权限，
         不给的话 setForeground 直接抛，任务退回"进程在才活着"。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 13 起通知要运行时权限。不给也能下（前台服务照跑），只是通知栏那条进度不出现，
         所以界面里的进度不能只靠通知。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="长文阅读"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:theme="@style/Theme.BookReader.Splash">
        <!-- enableOnBackInvokedCallback：targetSdk 37 下官方要求的声明。不写它系统每次都要在我们进程里
             打一条 `W OnBackInvokedCallback: ... is not enabled for the application.`，
             而且预测式返回只能走旧的回退路径。全应用的返回都走 Compose 的 BackHandler，
             这条链子（目录页→听书页→选段→抽屉→菜单→退出）在真机上逐格走过。 -->
        <!-- usesCleartextTraffic 是给内网 Ollama / LM Studio / 自建中转留的口子（他选的那档"两种都收"）。
             代价：http:// 地址上秘钥和正文都是明文走网，所以填 http 时界面必须标出来。 -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <!-- configChanges：pdf/pptx 抽屉里那颗「旋转屏幕」要真的横过来而不丢现场。
                 不声明的话转屏会重建 Activity，正在看的那一页、双指放大的倍数、抽屉开着哪一层
                 全得靠存档恢复（pdf 还要重开一次 renderer）；声明了之后 Compose 只是拿到新的窗口尺寸，
                 页码和缩放原地留着。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 文件管理器里"用本应用打开"：content:// 走 uri 授权，不需要存储权限。
                 mime 列表要跟 BookLibrary 的入库分派和书架那颗导入按钮的 picker 保持一致，
                 少一行就是"这个格式我们能读，但系统不会想到我们"。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="file" android:mimeType="text/plain" />
                <data android:scheme="content" android:mimeType="text/markdown" />
                <data android:scheme="file" android:mimeType="text/markdown" />
                <data android:scheme="content" android:mimeType="application/epub+zip" />
                <data android:scheme="file" android:mimeType="application/epub+zip" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="file" android:mimeType="application/pdf" />
                <data android:scheme="content" android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:scheme="file" android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:scheme="content" android:mimeType="application/x-mobipocket-ebook" />
                <data android:scheme="file" android:mimeType="application/x-mobipocket-ebook" />
                <data android:scheme="content" android:mimeType="application/vnd.amazon.ebook" />
                <data android:scheme="file" android:mimeType="application/vnd.amazon.ebook" />
                <data android:scheme="content" android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:scheme="file" android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>
        </activity>
        <!-- WorkManager 的前台服务：2.12.0 自带的那份清单里 SystemForegroundService **没有**
             android:foregroundServiceType，而 worker 调了 setForeground(dataSync) ——
             Android 14 起系统直接拒："foregroundServiceType 0x1 is not a subset of 0x0"，
             表现是一点下载就崩、并且因为队列里还有没跑完的活，之后每次开应用都崩在启动上。
             库里没给的就是我们该补的：按官方文档用 tools:node="merge" 把类型并到它那个 service 元素上。 -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
