{
  "id": "aixiashu",
  "name": "爱下书小说网",
  "homeUrl": "http://www.aixiashu.la/",
  "charset": "utf-8",
  "note": "2026-10-11 从这台机实测：首页没有搜索框，口是 /modules/article/search.php（POST searchkey）。#list 里一个 dl 两个 dt，第一个 dt 下面 9 条是倒序，「《剑来》正文」那个 dt 之后 1307 条才是正序。正文用 <br> 分段、不分页、不加密。已知一处是站点自己的数据错：最后 83 条（第1章 少年游…第83章 今日无事）面包屑仍写着剑来，抽出来的正文却是别的书。",
  "cover": "#fmimg img @src",
  "coverFrom": "/files/article/image/{g}/{b}/{b}s.jpg",
  "intro": "#intro",
  "hot": {"url": "http://www.aixiashu.la/", "group": "div.content", "item": "ul li", "bookName": "a", "author": "@text", "category": "h2", "bookUrl": "a@href"},
  "search": {
    "url": "http://www.aixiashu.la/modules/article/search.php",
    "method": "POST",
    "data": "{searchkey: %s}",
    "item": "table.grid > tbody > tr",
    "bookName": "td:nth-child(1) > a",
    "author": "td:nth-child(3)",
    "latestChapter": "td:nth-child(2) > a",
    "wordCount": "td:nth-child(4)",
    "lastUpdateTime": "td:nth-child(5)",
    "category": "td:nth-child(6)",
    "bookUrl": "td:nth-child(1) > a@href"
  },
  "toc": {
    "item": "#list > dl > dt:nth-of-type(2) ~ dd > a"
  },
  "chapter": {
    "content": "#content",
    "filter": []
  },
  "crawl": {
    "concurrency": 3,
    "minIntervalMs": 500,
    "maxIntervalMs": 1500,
    "maxAttempts": 3
  }
}
