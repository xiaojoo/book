{
  "id": "shuhu",
  "name": "小说虎（合成夹具）",
  "homeUrl": "http://www.example-hu.com/",
  "note": "测的是三件事：相对链接要补成绝对、正文用 <p> 分段、水印要能被 filter 掉",
  "charset": "utf-8",
  "search": {
    "url": "http://www.example-hu.com/?q=%s",
    "method": "GET",
    "item": "div.wrap > div.result > div",
    "bookName": "dl > dt > a",
    "author": "dl > dt > span",
    "intro": "dl > dd",
    "bookUrl": "dl > dt > a@href"
  },
  "toc": {
    "item": "#list > dl > dd > a"
  },
  "chapter": {
    "content": "#content",
    "filter": [
      "一秒记住【小说虎.*?】",
      "\\(本章完\\)"
    ]
  },
  "crawl": {
    "concurrency": 3
  }
}
